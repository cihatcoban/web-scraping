# ============================================================================
# Web Scraping Toolkit — Environment Configuration Template
# Copy this file to `.env` and customize values before running scrapers.
# Note: SEC EDGAR requires a descriptive User-Agent in the format:
#   SampleCompanyName AdminContact@<sample-company-domain>.com
# ============================================================================

# Custom User-Agent header sent with HTTP requests (Required for SEC EDGAR & Wikipedia compliance)
SCRAPER_USER_AGENT="WebScrapingToolkit/1.0 (https://github.com/cihatcoban/web-scraping; contact@example.com)"

# HTTP Request timeout in seconds
SCRAPER_TIMEOUT_SECONDS=15

# Maximum automatic retries for transient HTTP errors (429, 500, 502, 503, 504)
SCRAPER_MAX_RETRIES=3

# Backoff factor (in seconds) between retry attempts
SCRAPER_BACKOFF_FACTOR=1.0

# Minimum delay (in seconds) between consecutive requests for rate limiting
SCRAPER_RATE_LIMIT_DELAY=0.2

# Default directory for exported CSV/JSON datasets
SCRAPER_OUTPUT_DIR="data"

# Logging level (DEBUG, INFO, WARNING, ERROR)
SCRAPER_LOG_LEVEL="INFO"

# Target URLs (override if testing against mirrors or local fixtures)
WIKIPEDIA_COMPANIES_URL="https://en.wikipedia.org/wiki/List_of_largest_companies_in_the_United_States_by_revenue"
SEC_EDGAR_BASE_URL="https://www.sec.gov/Archives/edgar/data/"
